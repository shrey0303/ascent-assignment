# Copy to .env and fill in. Any OpenAI-compatible endpoint works; switching provider is config only.

# --- Groq (default) ---
LLM_BASE_URL=https://api.groq.com/openai/v1
LLM_API_KEY=
LLM_MODEL=openai/gpt-oss-120b
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60
LLM_REASONING_EFFORT=low

# --- Smaller model for the comparison run (Groq) ---
# LLM_MODEL=openai/gpt-oss-20b
# LLM_PRICE_IN_PER_M=0.075
# LLM_PRICE_OUT_PER_M=0.30

# --- OpenRouter alternative ---
# LLM_BASE_URL=https://openrouter.ai/api/v1
# LLM_MODEL=openai/gpt-oss-120b

# development | production. In production the app refuses to start unless SECRET_KEY is random and >= 32 chars.
APP_ENV=development
# Signing key for session and confirmation tokens, e.g. python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# Password for every test login listed in data/users.json
DEMO_PASSWORD=demo123

# Optional overrides
# DATA_DIR=./data
# DB_PATH=./var/app.db
