# Copy this file to .env and fill in the two keys. Any OpenAI-style API works, so switching provider is a config change.

# --- Main models: OpenRouter, with every call served by Groq (this is what the reported runs used) ---
# Groq's own free tier can't finish a full eval run in a day, and its paid tier wasn't open to new sign-ups,
# so the calls go through OpenRouter pinned to Groq: same models, same prices.
LLM_BASE_URL=https://openrouter.ai/api/v1
LLM_API_KEY=
LLM_PROVIDER=groq
LLM_MODEL=openai/gpt-oss-120b
LLM_PRICE_IN_PER_M=0.15
LLM_PRICE_OUT_PER_M=0.60
LLM_REASONING_EFFORT=low
# Prompt Guard isn't on OpenRouter, so the injection check calls Groq directly. The free tier is enough.
INJECTION_BASE_URL=https://api.groq.com/openai/v1
INJECTION_API_KEY=

# --- Or use Groq for everything: set LLM_BASE_URL=https://api.groq.com/openai/v1 and LLM_API_KEY=<groq key>,
# and leave LLM_PROVIDER, INJECTION_BASE_URL and INJECTION_API_KEY empty.

# --- The smaller model used for the comparison run ---
# LLM_MODEL=openai/gpt-oss-20b
# LLM_PRICE_IN_PER_M=0.075
# LLM_PRICE_OUT_PER_M=0.30

# --- Labelling model and request check (same endpoint and key as above) ---
# Labels are saved in cache/labels.json. Changing any of these settings makes the app label again.
# CLASSIFIER_MODEL=openai/gpt-oss-safeguard-20b   # score it with: python -m evals.labels_check
# INTENT_MODEL=openai/gpt-oss-20b
# CLASSIFIER_PRICE_IN_PER_M=0.075
# CLASSIFIER_PRICE_OUT_PER_M=0.30
# CLASSIFIER_REASONING_EFFORT=medium
# LABEL_VOTES=5
# LABEL_AGREEMENT=0.75
# INTENT_VOTES=3
# Sentence-by-sentence answer check. Off: in testing it removed correct facts and was too slow (see EVALUATION.md).
# ANSWER_CHECK_ENABLED=false
# ANSWER_CHECK_MODEL=openai/gpt-oss-120b
# ANSWER_CHECK_VOTES=3
# ANSWER_CHECK_REASONING_EFFORT=low
# ANSWER_CHECK_PRICE_IN_PER_M=0.15
# ANSWER_CHECK_PRICE_OUT_PER_M=0.60
# INJECTION_MODEL=meta-llama/llama-prompt-guard-2-86m
# INJECTION_THRESHOLD=0.5

# development or production. In production the app won't start unless SECRET_KEY is random and 32+ characters.
APP_ENV=development
# Signs login sessions and Confirm tokens. Make one with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=change-me
# The password for every test login in data/users.json
DEMO_PASSWORD=demo123

# Optional
# DATA_DIR=./data
# DB_PATH=./var/app.db
